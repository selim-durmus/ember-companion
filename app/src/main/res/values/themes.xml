        <item name="android:windowSplashScreenBackground">@color/ember_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ember_icon_background</item>
    </style>
</resources>
