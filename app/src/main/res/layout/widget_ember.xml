<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetMugName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/default_mug_name"
        android:textColor="@color/ember_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetCurrentTemperature"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/not_available"
        android:textColor="@color/ember_ink"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_target_placeholder"
        android:textColor="@color/ember_copper_dark"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/not_connected"
        android:textColor="@color/ember_sage"
        android:textSize="11sp" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widgetRefresh"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/refresh"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widgetPreset"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/widget_preset"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widgetHeaterOff"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/widget_off"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
